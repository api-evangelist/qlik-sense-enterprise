          "name": "Qlik Sense Enterprise Publish application object",
          "request": {
            "name": "Qlik Sense Enterprise Publish application object",
            "description": {
              "content": "Publishes an application object such as a sheet or story, making it available to all users who can access the application.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "appobject",
                ":id",
                "publish"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "Xrfkey",
                  "value": "<string>",
                  "description": "(Required) Cross-site request forgery prevention key. Must be 16 arbitrary characters matching the X-Qlik-Xrfkey header value."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "id",
                  "description": "(Required) Unique identifier (GUID) of the entity"
                },
                {
                  "description": "Qlik Sense server hostname",
