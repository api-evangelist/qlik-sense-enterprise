{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qlik Sense Enterprise Qlik Sense Service About Health API",
    "version": "2025.11.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Qlik-Xrfkey",
      "value": "{{X-Qlik-Xrfkey}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Qlik Sense Enterprise Check proxy service health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}/api/about/v1/health"
          },
          "docs": "Returns the health status of the Qlik Sense Proxy Service."
        }
      ]
    }
  ],
  "bundled": true
}