          "name": "Qlik Sense Enterprise Get system information",
          "request": {
            "name": "Qlik Sense Enterprise Get system information",
            "description": {
              "content": "Retrieves system information about the Qlik Sense site including the product name, version, release label, and deployment details.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "systeminfo"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "Xrfkey",
                  "value": "<string>",
                  "description": "(Required) Cross-site request forgery prevention key. Must be 16 arbitrary characters matching the X-Qlik-Xrfkey header value."
                }
              ],
              "variable": [
                {
                  "description": "Qlik Sense server hostname",
                  "type": "any",
                  "value": "{{server}}",
                  "key": "server"
                }
              ]
